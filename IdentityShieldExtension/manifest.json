{
  "manifest_version": 3,
  "name": "Identity Shield",
  "version": "1.0",
  "description": "Pings the Identity Engine API on every new website.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}